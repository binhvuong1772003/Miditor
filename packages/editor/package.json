{
  "name": "@miditor/editor",
  "version": "0.0.0",
  "description": "Miditor editor: <Editor> with canvas, layers, properties and drag and drop.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./locales/vi": {
      "import": {
        "types": "./dist/locales/vi.d.mts",
        "default": "./dist/locales/vi.mjs"
      },
      "require": {
        "types": "./dist/locales/vi.d.cts",
        "default": "./dist/locales/vi.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@miditor/core": "workspace:*",
    "@miditor/render": "workspace:*",
    "react-moveable": "0.56.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "^4.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "5.0.16"
  }
}
