{
  "name": "miditor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "perf": "node e2e/measure-renders.mjs",
    "dev": "pnpm --filter playground dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
